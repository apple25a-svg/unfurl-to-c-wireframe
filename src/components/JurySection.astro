---
// 評選方式：上＝標題＋說明（左）＋三角 infographic（右）；下＝評審人物卡，依三類分欄。
// 姓名/頭像待 PO 補；現用佔位。
import JuryCircle from './JuryCircle.astro';

const groups = [
  { cat: '編輯部', members: [{ role: '總編輯' }, { role: '美妝主編' }] },
  { cat: '美妝達人', members: [{ role: '知名彩妝師' }, { role: '保養領域 KOL' }] },
  { cat: '專業醫師', members: [{ role: '皮膚科醫師' }, { role: '醫學美容醫師' }] },
];
---

<section id="about" class="scroll-mt-20 bg-bg-card">
  <div class="mx-auto max-w-frame px-6 py-16 md:px-9 md:py-20">
    <!-- 上：auwa 式左欄（eyebrow → 大標 → 小灰說明）＋右三角 infographic -->
    <div class="grid items-center gap-12 md:grid-cols-2 md:gap-16">
      <div>
        <p class="text-xs tracking-[3px] text-ink-tertiary">關於評選</p>
        <h2 class="mt-5 font-serif text-3xl leading-tight text-heading md:text-[44px]">
          不分名次，<br />留下值得被看見的。
        </h2>
        <p class="mt-8 max-w-[460px] text-base leading-relaxed text-ink-body md:text-lg">
          今年的入選由專業評審團主導，由女人我最大編輯部、美妝達人與專業醫師三方檢視，依 <span class="font-serif italic">UNFURL</span> 六大趨勢，選出最具代表性的年度品項。
        </p>
      </div>
      <JuryCircle />
    </div>

    <!-- 下：評審人物卡，依三類分欄 -->
    <div class="mt-16 grid gap-10 md:mt-20 md:grid-cols-3 md:gap-8">
      {
        groups.map((g) => (
          <div>
            <p class="border-b border-line pb-3 text-xs tracking-[2px] text-ink-tertiary">{g.cat}</p>
            <div class="mt-6 flex gap-6">
              {g.members.map((m) => (
                <div class="flex-1">
                  <div class="mb-3 flex h-24 w-24 items-center justify-center rounded-full border-[0.5px] border-line bg-bg">
                    <i class="ti ti-user text-3xl text-ink-tertiary" aria-hidden="true" />
                  </div>
                  <p class="text-base font-medium text-ink">姓名待補</p>
                  <p class="mt-1 text-xs leading-snug text-ink-secondary">{m.role}</p>
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
