---
// Hero：KV 花園背景（圖內已含白霧天空淡出→花卉草地）。桌機 kv-desktop.jpg；手機 4:5 版之後再加 media query。
import { trends } from '../data/trends.js';

// 花圃槽位：一個趨勢一槽。桌機顯示全部、手機只放代表花。right/left + top + width 待 Chofi 微調。
// 圖未產的趨勢會自動隱藏（img onerror），所以現在只會出現已有圖的那朵。
const positions = {
  unfiltered: 'left:7%; top:16%; width:clamp(120px,15vw,190px);',
  noble: 'right:8%; top:13%; width:clamp(130px,16vw,200px);',
  fortify: 'right:6%; top:40%; width:clamp(130px,16vw,210px);',
  unique: 'left:9%; top:38%; width:clamp(120px,15vw,190px);',
  ritual: 'left:12%; top:66%; width:clamp(110px,14vw,180px);',
  longevity: 'right:11%; top:64%; width:clamp(120px,15vw,190px);',
};

// 手機代表花（1-2 朵，避免擁擠又不空）
const mobileFeatured = ['fortify', 'ritual'];
const mobilePos = [
  'right:6%; top:13%; width:40vw; max-width:175px;',
  'left:6%; top:62%; width:35vw; max-width:155px;',
];
const mobileBubbles = trends.filter((t) => mobileFeatured.includes(t.id) && t.image);
---

<section
  class="relative flex min-h-screen flex-col items-center justify-center px-6 pb-[18vh] pt-20 text-center"
  style="background-color:#F7F6F3; background-image:url('/kv-desktop.jpg'); background-repeat:no-repeat; background-position:bottom center; background-size:cover;"
>
  <h1 class="font-serif text-2xl tracking-[3px] text-heading md:text-[28px]">美，由我綻放</h1>
  <p class="mt-3 font-serif text-[44px] italic leading-none tracking-[8px] text-heading md:text-display-1">
    UNFURL
  </p>

  <!-- 可點提示（文案，手機桌機都顯示，不靠 hover） -->
  <p class="mt-9 text-xs tracking-[1px] text-ink-secondary">
    點花朵展開六大趨勢<i class="ti ti-arrow-right ml-1 align-middle" aria-hidden="true"></i>
  </p>
  <p class="mt-3 text-xs italic text-ink-tertiary">滑動探索 ↓</p>

  <!--
    花圃：一朵花 = 一個趨勢，點擊捲到該趨勢區（#trend-xxx）。
    桌機顯示全部槽位；位置改 positions、大小改 width。圖未產者自動隱藏。
  -->
  <div class="pointer-events-none absolute inset-0 z-10 hidden md:block">
    {
      trends.map(
        (t) =>
          t.image && (
            <a
              href={`#trend-${t.id}`}
              class="bubble pointer-events-auto absolute"
              style={positions[t.id]}
              data-track={`bubble_${t.id}`}
              aria-label={`${t.zh} 趨勢`}
            >
              <img
                src={t.image}
                alt={t.zh}
                class="h-auto w-full"
                onerror="this.closest('a').style.display='none'"
              />
            </a>
          )
      )
    }
  </div>

  <!-- 手機：只放 1-2 朵代表花 -->
  <div class="pointer-events-none absolute inset-0 z-10 md:hidden">
    {
      mobileBubbles.map((t, i) => (
        <a
          href={`#trend-${t.id}`}
          class="bubble pointer-events-auto absolute"
          style={mobilePos[i]}
          data-track={`bubble_${t.id}`}
          aria-label={`${t.zh} 趨勢`}
        >
          <img
            src={t.image}
            alt={t.zh}
            class="h-auto w-full"
            onerror="this.closest('a').style.display='none'"
          />
        </a>
      ))
    }
  </div>
</section>

<style>
  /* 花朵常駐微浮動（不靠 hover，手機也看得出可互動）。浮動套在 img、hover lift 套在 a，互不衝突 */
  .bubble img {
    animation: bubble-float 6s ease-in-out infinite;
    filter: drop-shadow(0 6px 16px rgba(150, 120, 190, 0.18));
    will-change: transform;
  }
  .bubble:nth-of-type(2) img {
    animation-delay: -2s;
  }
  .bubble:nth-of-type(3) img {
    animation-delay: -3.5s;
  }
  .bubble:nth-of-type(4) img {
    animation-delay: -1s;
  }
  .bubble:nth-of-type(5) img {
    animation-delay: -4.5s;
  }
  .bubble:nth-of-type(6) img {
    animation-delay: -2.8s;
  }
  @keyframes bubble-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-7px);
    }
  }
  /* 桌機 hover 再加強：整朵浮起放大 */
  .bubble {
    transition: transform 0.45s ease, filter 0.45s ease;
  }
  .bubble:hover {
    transform: translateY(-6px) scale(1.04);
    filter: drop-shadow(0 14px 26px rgba(150, 120, 190, 0.28));
  }
  @media (prefers-reduced-motion: reduce) {
    .bubble img {
      animation: none;
    }
  }
</style>
