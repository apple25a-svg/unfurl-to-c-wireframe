---
// Hero：KV 花園背景。中央品牌 stack（logo＋標語＋UNFURL＋心測 pill）浮在花圃之上。
import { trends } from '../data/trends.js';

// 花圃槽位：靠外圈，中央留乾淨給品牌 stack。right/left + top + width 待 Chofi 微調。
// 圖未產的趨勢會自動隱藏（img onerror）。
const positions = {
  unfiltered: 'left:5%; top:18%; width:clamp(110px,14vw,180px);',
  noble: 'right:6%; top:15%; width:clamp(110px,14vw,180px);',
  fortify: 'left:8%; top:46%; width:clamp(110px,14vw,180px);',
  unique: 'right:7%; top:44%; width:clamp(110px,14vw,180px);',
  ritual: 'left:14%; top:74%; width:clamp(110px,14vw,180px);',
  longevity: 'right:15%; top:72%; width:clamp(110px,14vw,180px);',
};

// 手機代表花（1-2 朵，避免擁擠又不空）
const mobileFeatured = ['fortify', 'ritual'];
const mobilePos = [
  'right:5%; top:14%; width:38vw; max-width:165px;',
  'left:5%; top:64%; width:34vw; max-width:150px;',
];
const mobileBubbles = trends.filter((t) => mobileFeatured.includes(t.id) && t.image);
---

<section
  class="relative flex min-h-screen flex-col items-center justify-center px-6 pb-24 pt-20 text-center"
  style="background-color:#F7F6F3; background-image:url('/kv-desktop.jpg'); background-repeat:no-repeat; background-position:bottom center; background-size:cover;"
>
  <!-- 中央品牌 stack（z-20，浮在花圃之上，花不會蓋住）。UNFURL 英雄式：logo 標記 → 標語小標 → UNFURL 主角 → 導言最輕 -->
  <div class="relative z-20 flex flex-col items-center">
    <img src="/logo.png" alt="女人我最大 Queen" class="w-24 md:w-28" />
    <p class="mt-5 font-serif text-base tracking-[4px] text-ink-secondary md:text-lg">美，由我綻放</p>
    <h1 class="mt-2 font-serif text-[64px] italic leading-none tracking-[8px] text-heading md:text-[88px]">UNFURL</h1>
    <p class="mt-6 max-w-lg text-sm leading-relaxed text-ink-tertiary">女人我最大賞，是我們每年對美妝市場的一次完整閱讀。不排名，而是用趨勢說清楚今年的美，正在往哪裡走。</p>
    <a
      href="#"
      class="mt-8 inline-flex items-center gap-2 rounded-full bg-primary px-8 py-3.5 text-base font-medium text-white transition-colors hover:bg-primary-deep"
      data-track="hero_quiz"
    >
      <i class="ti ti-flower" aria-hidden="true"></i>測測我是什麼花
    </a>
  </div>

  <!-- 底部提示：點花朵（主）＋小 ↓ 箭頭 -->
  <div class="absolute inset-x-0 bottom-7 z-20 flex flex-col items-center gap-2">
    <p class="text-xs tracking-[1px] text-ink-secondary">
      點花朵展開六大趨勢<i class="ti ti-arrow-right ml-1 align-middle" aria-hidden="true"></i>
    </p>
    <i class="ti ti-chevron-down scroll-cue text-lg text-ink-tertiary" aria-hidden="true"></i>
  </div>

  <!-- 花圃（桌機）：一朵花 = 一個趨勢，點擊捲到 #trend-xxx。圖未產者自動隱藏 -->
  <div class="pointer-events-none absolute inset-0 z-10 hidden md:block">
    {
      trends.map(
        (t) =>
          t.image && (
            <a
              href={`#trend-${t.id}`}
              class="bubble pointer-events-auto absolute"
              style={positions[t.id]}
              data-track={`bubble_${t.id}`}
              aria-label={`${t.key} ${t.zhName} 趨勢`}
            >
              <img
                src={t.image}
                alt={t.zhName}
                class="h-auto w-full"
                onerror="this.closest('a').style.display='none'"
              />
            </a>
          )
      )
    }
  </div>

  <!-- 花圃（手機）：只放 1-2 朵代表花 -->
  <div class="pointer-events-none absolute inset-0 z-10 md:hidden">
    {
      mobileBubbles.map((t, i) => (
        <a
          href={`#trend-${t.id}`}
          class="bubble pointer-events-auto absolute"
          style={mobilePos[i]}
          data-track={`bubble_${t.id}`}
          aria-label={`${t.key} ${t.zhName} 趨勢`}
        >
          <img
            src={t.image}
            alt={t.zhName}
            class="h-auto w-full"
            onerror="this.closest('a').style.display='none'"
          />
        </a>
      ))
    }
  </div>
</section>

<style>
  /* 花朵常駐微浮動（不靠 hover，手機也看得出可互動）。浮動套在 img、hover lift 套在 a，互不衝突 */
  .bubble img {
    animation: bubble-float 6s ease-in-out infinite;
    filter: drop-shadow(0 6px 16px rgba(150, 120, 190, 0.18));
    will-change: transform;
  }
  .bubble:nth-of-type(2) img {
    animation-delay: -2s;
  }
  .bubble:nth-of-type(3) img {
    animation-delay: -3.5s;
  }
  .bubble:nth-of-type(4) img {
    animation-delay: -1s;
  }
  .bubble:nth-of-type(5) img {
    animation-delay: -4.5s;
  }
  .bubble:nth-of-type(6) img {
    animation-delay: -2.8s;
  }
  @keyframes bubble-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-7px);
    }
  }
  /* 桌機 hover 再加強：整朵浮起放大 */
  .bubble {
    transition: transform 0.45s ease, filter 0.45s ease;
  }
  .bubble:hover {
    transform: translateY(-6px) scale(1.04);
    filter: drop-shadow(0 14px 26px rgba(150, 120, 190, 0.28));
  }
  /* 滑動小箭頭：緩慢上下提示 */
  .scroll-cue {
    animation: scroll-bounce 1.8s ease-in-out infinite;
  }
  @keyframes scroll-bounce {
    0%,
    100% {
      transform: translateY(0);
      opacity: 0.65;
    }
    50% {
      transform: translateY(4px);
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .bubble img,
    .scroll-cue {
      animation: none;
    }
  }
</style>
