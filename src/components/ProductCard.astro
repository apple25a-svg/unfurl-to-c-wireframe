---
// 選品卡（auwa「Our Journal」式）：產品圖在上 → 小字 eyebrow → 襯線標題 → 簡短說明。
// 無邊框、無厚陰影。此階段沒有產品頁可連 → 非連結、無 hover 效果。
interface Props {
  name: string;
  desc: string;
}
const { name, desc } = Astro.props;
---

<div data-track="product_card">
  <!-- 產品圖（未產時漸層佔位） -->
  <div
    class="flex aspect-[4/5] items-center justify-center overflow-hidden rounded-sm text-ink-tertiary"
    style="background:linear-gradient(135deg,#F3DED6,#E4C0B6)"
  >
    <i class="ti ti-photo text-2xl" aria-hidden="true"></i>
  </div>

  <p class="mt-4 font-serif text-lg leading-snug text-heading">{name}</p>
  <p class="mt-1.5 text-xs leading-relaxed text-ink-secondary">{desc}</p>
</div>
