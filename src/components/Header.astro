---
// 浮動 header：第一屏隱藏（logo＋CTA），等 Hero 正中央 CTA 滑出畫面後才淡入＋半透明白底。
// 用 IntersectionObserver 盯 Hero 的中央 CTA（data-track="hero_quiz"）。
---

<header id="site-header" class="fixed inset-x-0 top-0 z-50 transition-all duration-300">
  <div class="hdr-inner mx-auto flex h-16 max-w-frame items-center justify-between px-6 md:px-8">
    <!-- logo -->
    <a href="/" class="flex items-center gap-2" data-track="nav_logo">
      <img src="/logo.png" alt="女人我最大 Queen" class="h-7 w-auto" />
    </a>

    <!-- 心測 CTA -->
    <a href="#quiz" class="btn-primary !px-5 !py-2" data-track="nav_quiz">探索我的花精靈</a>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  const heroCta = document.querySelector('[data-track="hero_quiz"]');

  if (header && heroCta) {
    // Hero 中央 CTA 還看得到 → 隱藏 header；完全滑出 → 顯示
    const io = new IntersectionObserver(
      ([entry]) => header.classList.toggle('is-revealed', !entry.isIntersecting),
      { threshold: 0 }
    );
    io.observe(heroCta);
  } else if (header) {
    // 沒有 Hero CTA 的頁面：退回捲動顯示
    const onScroll = () => header.classList.toggle('is-revealed', window.scrollY > 80);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>

<style>
  #site-header {
    background: transparent;
  }
  /* 內容（logo＋CTA）第一屏隱藏，揭曉後淡入 */
  .hdr-inner {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s ease;
  }
  #site-header.is-revealed .hdr-inner {
    opacity: 1;
    pointer-events: auto;
  }
  /* 半透明白底也只在揭曉後出現 */
  #site-header.is-revealed {
    background: rgba(255, 255, 255, 0.8);
    backdrop-filter: saturate(180%) blur(12px);
    -webkit-backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 0.5px solid rgba(44, 44, 42, 0.1);
  }
</style>
