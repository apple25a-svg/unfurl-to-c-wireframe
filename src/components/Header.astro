---
// 浮動 header：透明浮在 hero 上，捲動後變半透明白底＋模糊（Wealthsimple 風）
---

<header id="site-header" class="fixed inset-x-0 top-0 z-50 transition-all duration-300">
  <div class="mx-auto flex h-16 max-w-frame items-center justify-between px-6 md:px-8">
    <a href="/" class="flex items-center gap-2" data-track="nav_logo">
      <img src="/logo.png" alt="女人我最大 Queen" class="h-7 w-auto" />
    </a>

    <nav class="hidden items-center gap-8 text-xs text-ink md:flex">
      <a href="#" class="transition-colors hover:text-primary">趨勢</a>
      <a href="#" class="transition-colors hover:text-primary">盤點</a>
      <a href="#" class="transition-colors hover:text-primary">評選</a>
    </nav>

    <a
      href="#"
      class="inline-flex items-center gap-1.5 rounded-full bg-primary px-5 py-2 text-xs font-medium text-white transition-colors hover:bg-primary-deep"
      data-track="nav_quiz"
    >
      <i class="ti ti-flower" aria-hidden="true"></i>測測我是什麼花
    </a>
  </div>
</header>

<script>
  const h = document.getElementById('site-header');
  const onScroll = () => {
    if (!h) return;
    h.classList.toggle('is-scrolled', window.scrollY > 24);
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  #site-header {
    background: transparent;
  }
  #site-header.is-scrolled {
    background: rgba(255, 255, 255, 0.8);
    backdrop-filter: saturate(180%) blur(12px);
    -webkit-backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 0.5px solid rgba(44, 44, 42, 0.1);
  }
</style>
