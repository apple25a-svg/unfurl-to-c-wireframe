---
// 看更多趨勢：其他五大趨勢中文大字＋英文，點擊直達該趨勢頁。取代單個「下一趨勢」banner。
// 亮暖底，避免與深色 footer 撞色。共用於列表頁與閱讀頁。
import { trends } from '../data/trends.js';
interface Props {
  currentId: string;
}
const { currentId } = Astro.props;
const others = trends.filter((t) => t.id !== currentId);
---

<section class="border-t border-line bg-bg-surface px-6 md:px-9">
  <div class="mx-auto max-w-frame py-16 md:py-24">
    <p class="text-xs tracking-[3px] text-ink-tertiary">UNFURL · 看更多趨勢</p>
    <div class="mt-6 md:mt-8">
      {
        others.map((t) => (
          <a
            href={`/trends/${t.id}`}
            class="group flex items-baseline gap-4 border-b border-line py-5 md:py-6"
            data-track="cta_more_trend"
          >
            <h2 class="font-serif text-3xl leading-none text-heading transition-colors group-hover:text-primary md:text-[44px]">
              {t.zhName}
            </h2>
            <span class="font-serif text-lg italic text-ink-tertiary md:text-xl">{t.key}</span>
            <i
              class="ti ti-arrow-right ml-auto self-center text-ink-tertiary transition-all group-hover:translate-x-1 group-hover:text-primary"
              aria-hidden="true"
            />
          </a>
        ))
      }
    </div>
  </div>
</section>
