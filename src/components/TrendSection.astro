---
import ProductCard from './ProductCard.astro';

interface Product {
  name: string;
  desc: string;
}
interface Props {
  id: string;
  key: string;
  zhName: string;
  vibes?: string[];
  body: string;
  products: Product[];
  image?: string;
  articleHref?: string;
  listHref?: string;
}
const { id, key, zhName, vibes = [], body, products, image, articleHref = '#', listHref = '#' } = Astro.props;
---

<section id={`trend-${id}`} class="border-b-[0.5px] border-line">
  <div class="mx-auto max-w-frame px-6 py-14 md:px-9 md:py-16">
    <div class="md:grid md:grid-cols-[140px_1fr] md:gap-8">
      <!-- 花（趨勢識別；圖未產時自動隱藏） -->
      <div class="mb-4 md:mb-0">
        {image && (
          <img
            src={image}
            alt={zhName}
            class="h-auto w-[92px] md:w-[132px]"
            onerror="this.style.display='none'"
          />
        )}
      </div>

      <!-- 內容 -->
      <div>
        <h2 class="text-2xl text-heading md:text-3xl">
          <span class="font-serif">{key}</span> <span class="font-sans font-semibold">· {zhName}</span>
        </h2>

        <!-- 趨勢關鍵字（vibe 標籤；參考 britainsfavouritebutterfly TOP VIBES） -->
        {vibes.length > 0 && (
          <div class="mt-3 flex flex-wrap gap-2">
            {vibes.map((v) => (
              <span class="rounded-full border-[0.5px] border-ink/30 px-3 py-1 text-xs text-ink-secondary">{v}</span>
            ))}
          </div>
        )}

        <p class="mt-4 max-w-readable text-base leading-relaxed text-ink">{body}</p>

        <!-- 趨勢選品 -->
        <p class="mb-3 mt-7 text-xs tracking-wide text-ink-secondary">趨勢選品</p>
        <div class="grid grid-cols-2 gap-4 md:grid-cols-3">
          {products.map((p) => <ProductCard name={p.name} desc={p.desc} href={articleHref} />)}
        </div>

        <!-- 雙入口：主按鈕＋底線文字連結（參考 butterfly「View full profile」瘦身） -->
        <div class="mt-6 flex flex-wrap items-center gap-5">
          <a
            href={articleHref}
            class="inline-flex items-center gap-1.5 rounded-full bg-primary px-5 py-2.5 text-xs font-medium text-white transition-colors hover:bg-primary-deep"
            data-track="cta_shop"
          >
            看完整盤點<i class="ti ti-arrow-right" aria-hidden="true"></i>
          </a>
          <a
            href={listHref}
            class="inline-flex items-center gap-1 border-b border-ink/40 pb-0.5 text-xs text-ink transition-colors hover:border-ink"
            data-track="cta_trend"
          >
            閱讀完整趨勢<i class="ti ti-arrow-right" aria-hidden="true"></i>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
