---
import ProductCard from './ProductCard.astro';
import Rail from './Rail.astro';

interface Product {
  name: string;
  desc: string;
}
interface Props {
  id: string;
  key: string;
  zhName: string;
  vibes?: string[];
  body: string;
  products: Product[];
  cutout?: string;
  articleHref?: string;
  listHref?: string;
}
const { id, key, zhName, vibes = [], body, products, cutout, articleHref = '#', listHref = '#' } = Astro.props;
---

<section id={`trend-${id}`} class="border-b-[0.5px] border-line">
  <div class="mx-auto max-w-frame px-6 py-14 md:px-9 md:py-16">
    <div class="md:grid md:grid-cols-[400px_1fr] md:gap-10">
      <!-- 趨勢花＋英文圖說（植物圖鑑式：花在上、學名在下） -->
      <div class="mb-5 md:mb-0">
        {cutout && (
          <figure class="mx-auto w-[220px] md:mx-0 md:w-[360px]">
            <img
              src={cutout}
              alt={zhName}
              class="h-auto w-full"
              onerror="this.closest('figure').style.display='none'"
            />
            <figcaption class="mt-2 text-center font-serif text-[28px] italic text-ink-secondary md:text-[36px]">
              {key}
            </figcaption>
          </figure>
        )}
      </div>

      <!-- 內容 -->
      <div>
        <h3 class="font-serif text-xl font-medium text-heading md:text-2xl">{zhName}</h3>

        {vibes.length > 0 && (
          <div class="mt-3 flex flex-wrap gap-2">
            {vibes.map((v) => (
              <span class="rounded-full border-[0.5px] border-ink/30 px-3 py-1 text-xs text-ink-secondary">{v}</span>
            ))}
          </div>
        )}

        <p class="mt-4 max-w-[640px] text-base leading-relaxed text-ink-body">{body}</p>

        {products.length > 0 && (
          <div class="mt-7">
            <Rail count={products.length} gapClass="gap-4" fadeFrom="from-bg">
              {products.map((p) => (
                <div class="shrink-0">
                  <ProductCard name={p.name} desc={p.desc} image={p.img} />
                </div>
              ))}
            </Rail>
          </div>
        )}

        <div class="mt-8 flex flex-wrap items-center gap-6">
          <a href={listHref} class="btn-primary" data-track="cta_trend">了解趨勢</a>
          {products.length > 0 && (
            <a href={articleHref} class="btn-secondary" data-track="cta_shop">看選品</a>
          )}
        </div>
      </div>
    </div>
  </div>
</section>
