---
import ProductCard from './ProductCard.astro';

interface Product {
  name: string;
  desc: string;
}
interface Props {
  id: string;
  key: string;
  zhName: string;
  vibes?: string[];
  body: string;
  products: Product[];
  cutout?: string;
  articleHref?: string;
  listHref?: string;
}
const { id, key, zhName, vibes = [], body, products, cutout, articleHref = '#', listHref = '#' } = Astro.props;
---

<section id={`trend-${id}`} class="border-b-[0.5px] border-line">
  <div class="mx-auto max-w-frame px-6 py-14 md:px-9 md:py-16">
    <div class="md:grid md:grid-cols-[400px_1fr] md:gap-10">
      <!-- 趨勢花（去背花圖，非泡泡；圖未產自動隱藏） -->
      <div class="mb-5 md:mb-0">
        {cutout && (
          <img
            src={cutout}
            alt={zhName}
            class="h-auto w-[220px] md:w-[360px]"
            onerror="this.style.display='none'"
          />
        )}
      </div>

      <!-- 內容 -->
      <div>
        <h3 class="font-serif text-xl text-heading md:text-2xl">
          <span class="italic">{key}</span> <span class="font-medium">· {zhName}</span>
        </h3>

        {vibes.length > 0 && (
          <div class="mt-3 flex flex-wrap gap-2">
            {vibes.map((v) => (
              <span class="rounded-full border-[0.5px] border-ink/30 px-3 py-1 text-xs text-ink-secondary">{v}</span>
            ))}
          </div>
        )}

        <p class="mt-4 max-w-[640px] text-base leading-relaxed text-ink-body">{body}</p>

        {products.length > 0 && (
          <div class="mt-7 flex flex-wrap gap-4">
            {products.map((p) => <ProductCard name={p.name} desc={p.desc} image={p.img} />)}
          </div>
        )}

        <div class="mt-8 flex flex-wrap items-center gap-6">
          <a href={listHref} class="btn-primary" data-track="cta_trend">了解趨勢</a>
          {products.length > 0 && (
            <a href={articleHref} class="btn-secondary" data-track="cta_shop">看選品</a>
          )}
        </div>
      </div>
    </div>
  </div>
</section>
