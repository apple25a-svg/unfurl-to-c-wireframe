---
// 花精靈測驗（hi-fi）：home 開場 → quiz 答題（進度條/單複選/自動前進）→ result 花精靈＋保養趨勢。
// 資料與計分邏輯沿用 心理測驗/flower_quiz_prototype.html，UI 換成暖調設計系統。預設用第一版題目（QUIZ_A 題組1）。
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="花精靈測驗 · 女人我最大賞 2026">
  <a href="/" class="absolute left-6 top-6 z-30 md:left-9 md:top-7" data-track="quiz_logo">
    <img src="/logo.png" alt="女人我最大 Queen" class="h-7 w-auto" />
  </a>

  <main class="flex min-h-screen flex-col items-center justify-center px-6 py-24">
    <!-- 開場 -->
    <section id="home" class="mx-auto max-w-readable text-center">
      <p class="text-xs tracking-[4px] text-ink-tertiary">FLOWER QUIZ · 花精靈測驗</p>
      <h1 class="mt-6 font-serif text-3xl leading-tight text-heading md:text-[52px]">你，是哪一朵花？</h1>
      <p class="mx-auto mt-6 max-w-md text-base leading-relaxed text-ink-body">
        六道題、約一分鐘，透過一場關於花的小測驗，找到最貼近你的那一種美，與屬於你的年度保養主張。
      </p>
      <button id="start" type="button" class="btn-primary mt-10" data-track="quiz_start">開始測驗</button>
    </section>

    <!-- 答題 -->
    <section id="quiz" class="hide w-full max-w-readable">
      <div class="h-px w-full bg-line">
        <div id="bar" class="h-px bg-primary transition-all duration-300" style="width:0%"></div>
      </div>
      <div class="mt-6 flex items-center justify-between">
        <button id="prev" type="button" class="text-xs text-ink-tertiary transition-colors hover:text-ink disabled:opacity-40" data-track="quiz_prev">← 上一題</button>
        <p id="qnum" class="text-xs tracking-[2px] text-ink-tertiary">Question 1 / 6</p>
      </div>
      <h2 id="qtext" class="mt-6 font-serif text-2xl leading-snug text-heading md:text-[32px]"></h2>
      <p id="qhint" class="hide mt-3 text-xs text-ink-secondary"></p>
      <div id="opts" class="mt-8"></div>
      <button id="next" type="button" class="btn-primary mt-8 w-full justify-center" data-track="quiz_next" style="display:none">下一題</button>
    </section>

    <!-- 結果：六區塊（內外向視覺待補，先以文字 placeholder） -->
    <section id="result" class="hide mx-auto max-w-readable">
      <!-- 區塊一：花朵呈現 + 社群分享 -->
      <div class="text-center">
        <div id="flower" class="mx-auto flex aspect-square w-48 items-center justify-center rounded-full bg-bg-surface text-center text-xs leading-relaxed text-ink-tertiary md:w-56">
          花朵動畫／圖片<br />（內外向視覺 placeholder）
        </div>
        <button id="share" type="button" class="btn-secondary mt-6" data-track="quiz_share">分享我的花精靈</button>
      </div>

      <!-- 區塊二：正式名稱（文字＋圖） -->
      <div class="mt-12 text-center">
        <p id="rio" class="text-xs tracking-[3px] text-primary"></p>
        <h2 id="rname" class="mt-3 font-serif text-3xl leading-tight text-heading md:text-[48px]"></h2>
      </div>

      <!-- 區塊三：性格描述 -->
      <div class="mt-10">
        <p id="rquote" class="text-center font-serif text-lg italic text-ink-secondary md:text-xl"></p>
        <p id="rdesc" class="mx-auto mt-6 max-w-lg text-left text-base leading-loose text-ink-body"></p>
      </div>

      <!-- 區塊四：與你最合拍的花精靈（最懂你／最互補） -->
      <div class="mx-auto mt-14 max-w-md border-t border-line pt-10">
        <p class="text-center text-xs tracking-[2px] text-ink-tertiary">與你最合拍的花精靈</p>
        <div class="mt-6 grid grid-cols-2 gap-4 text-center">
          <div class="rounded-md bg-bg-surface p-5">
            <div class="mx-auto flex aspect-square w-20 items-center justify-center rounded-full bg-white text-[10px] text-ink-tertiary">圖</div>
            <p class="mt-3 text-xs text-ink-tertiary">最懂你</p>
            <p id="m1" class="mt-1 font-serif text-lg text-heading"></p>
          </div>
          <div class="rounded-md bg-bg-surface p-5">
            <div class="mx-auto flex aspect-square w-20 items-center justify-center rounded-full bg-white text-[10px] text-ink-tertiary">圖</div>
            <p class="mt-3 text-xs text-ink-tertiary">最互補</p>
            <p id="m2" class="mt-1 font-serif text-lg text-heading"></p>
          </div>
        </div>
      </div>

      <!-- 區塊五：保養主張（對應趨勢 + 美麗提案 + 盤點文連結） -->
      <div class="mx-auto mt-10 max-w-md rounded-md bg-bg-surface p-6 text-left">
        <p class="text-xs tracking-[2px] text-primary">你的年度保養主張</p>
        <p id="caret" class="mt-2 font-serif text-xl text-heading"></p>
        <p id="cared" class="mt-2 text-base leading-relaxed text-ink-body"></p>
        <p class="mt-4 border-t border-line pt-4 text-sm leading-relaxed text-ink-tertiary">女人我最大美麗提案 placeholder（待定稿）</p>
        <a id="ctaTrend" href="#" class="btn-secondary mt-5" data-track="quiz_result_trend">看趨勢</a>
      </div>

      <!-- 區塊六：生活小提案 -->
      <div class="mx-auto mt-10 max-w-md text-left">
        <p class="text-xs tracking-[2px] text-primary">生活小提案</p>
        <ul class="mt-3 space-y-2 text-sm leading-relaxed text-ink-tertiary">
          <li>· 生活小提案 placeholder 1（待定稿）</li>
          <li>· 生活小提案 placeholder 2（待定稿）</li>
          <li>· 生活小提案 placeholder 3（待定稿）</li>
        </ul>
      </div>

      <div class="mt-14 text-center">
        <button id="replay" type="button" class="text-xs text-ink-tertiary underline underline-offset-4 transition-colors hover:text-ink" data-track="quiz_replay">
          重新測一次
        </button>
      </div>
    </section>

    <!-- 登入（mock）：未登入時參加抽獎會先到這 -->
    <section id="login" class="hide mx-auto max-w-readable text-center">
      <p class="text-xs tracking-[4px] text-ink-tertiary">MEMBER LOGIN</p>
      <h2 class="mt-6 font-serif text-3xl leading-tight text-heading md:text-[40px]">登入 TVBS 會員</h2>
      <p class="mx-auto mt-6 max-w-md text-base leading-relaxed text-ink-body">
        參加抽獎需先登入 TVBS 會員，登入後可帶入你的會員資料。
      </p>
      <button id="mockLogin" type="button" class="btn-primary mt-10" data-track="lottery_login">模擬登入（demo）</button>
      <button id="loginSkip" type="button" class="mt-6 block w-full text-center text-xs text-ink-tertiary underline underline-offset-4 transition-colors hover:text-ink">先看測驗結果</button>
    </section>

    <!-- 抽獎資料表單 -->
    <section id="lottery" class="hide mx-auto max-w-readable">
      <h2 class="text-center font-serif text-3xl leading-tight text-heading md:text-[40px]">抽獎資料</h2>
      <p class="mx-auto mt-4 max-w-md text-center text-sm leading-relaxed text-ink-body">
        我們會以電子信件通知中獎者，請務必留下正確連絡資訊。
      </p>
      <p id="filledNote" class="hide mx-auto mt-5 max-w-md rounded-md bg-bg-surface p-3 text-center text-xs leading-relaxed text-primary">
        你已填寫過抽獎資料，以下為唯讀。
      </p>

      <form id="lotteryForm" class="mx-auto mt-8 max-w-md space-y-5">
        <input name="name" type="text" required placeholder="中文姓名 *" class="field" />
        <input name="email" type="email" required placeholder="聯絡 Email *" class="field" />
        <div>
          <input name="phone" type="tel" required placeholder="聯絡電話 *" class="field" />
          <p class="mt-1.5 text-xs text-ink-tertiary">請勿填入任何符號（如 - * #）</p>
        </div>
        <div>
          <p class="mb-2 text-xs text-ink-tertiary">寄送地址 *</p>
          <div class="grid grid-cols-2 gap-3">
            <select name="city" required class="field">
              <option value="" disabled selected>縣市</option>
            </select>
            <select name="area" required class="field">
              <option value="" disabled selected>鄉鎮市區</option>
            </select>
          </div>
          <input name="address" type="text" required placeholder="地址 *" class="field mt-3" />
        </div>

        <!-- 活動辦法（收合）＋ 同意勾選 -->
        <div class="overflow-hidden rounded-md border border-line">
          <button type="button" id="rulesToggle" class="flex w-full items-center justify-between px-4 py-3 text-left text-sm text-ink-body transition-colors hover:bg-bg-surface">
            <span>活動辦法</span>
            <span id="rulesCaret" class="text-ink-tertiary">＋</span>
          </button>
          <div id="rulesBody" class="hide max-h-60 space-y-3 overflow-y-auto border-t border-line px-4 py-4 text-xs leading-relaxed text-ink-tertiary"></div>
        </div>
        <label class="flex items-start gap-2 text-xs leading-relaxed text-ink-body">
          <input id="agree" name="agree" type="checkbox" required class="mt-0.5 shrink-0" />
          <span>我已閱讀並同意上述活動辦法與注意事項</span>
        </label>

        <button id="submitLottery" type="submit" class="btn-primary w-full justify-center" data-track="lottery_submit">確認送出</button>
        <button type="button" id="lotterySkip" class="block w-full text-center text-xs text-ink-tertiary underline underline-offset-4 transition-colors hover:text-ink">先看測驗結果</button>
      </form>
    </section>

    <!-- 是否參加抽獎 彈窗（Q6 後） -->
    <div id="lotteryPrompt" class="hide fixed inset-0 z-50 flex items-center justify-center bg-black/40 px-6">
      <div class="w-full max-w-sm rounded-lg bg-white p-8 text-center shadow-xl">
        <h3 class="font-serif text-2xl text-heading">要參加抽獎嗎？</h3>
        <p class="mt-3 text-sm leading-relaxed text-ink-body">
          填寫抽獎資料，就有機會抽中限定好禮。也可以先看你的花精靈結果。
        </p>
        <button id="toLottery" type="button" class="btn-primary mt-6 w-full justify-center" data-track="lottery_join">參加抽獎</button>
        <button id="skipLottery" type="button" class="mt-4 text-xs text-ink-tertiary underline underline-offset-4 transition-colors hover:text-ink" data-track="lottery_skip">先看測驗結果</button>
      </div>
    </div>
  </main>
</BaseLayout>

<script>
  import { SPIRITS, CARE, MATCH, CEIL, PRIORITY, QUIZ_A, QUIZ_B, SYS_TREND } from '../data/quiz.js';
  import { REGIONS, RULES } from '../data/lottery.js';

  const $ = (id) => document.getElementById(id);
  let ver = 'A', quiz = [], qi = 0, answers = [], currentSpirit = null;
  let resultSys = null, resultDir = null; // Q6 算完先存著，等使用者決定要不要抽獎

  // mock 登入/已填狀態（demo 用，之後接真實 TVBS 會員）：?login=1&filled=1
  const _p = new URLSearchParams(location.search);
  let mockLoggedIn = _p.get('login') === '1';
  const mockFilled = _p.get('filled') === '1';

  function show(id) {
    ['home', 'quiz', 'result', 'login', 'lottery'].forEach((x) => $(x).classList.add('hide'));
    $(id).classList.remove('hide');
    window.scrollTo(0, 0);
  }

  function start(v) {
    ver = v;
    quiz = v === 'A' ? QUIZ_A : QUIZ_B;
    qi = 0;
    answers = quiz.map((it) => (it.multi ? [] : null));
    show('quiz');
    renderQ();
  }

  function renderQ() {
    const item = quiz[qi];
    const multi = !!item.multi;
    $('qnum').textContent = 'Question ' + (qi + 1) + ' / ' + quiz.length;
    $('qtext').textContent = item.q;
    $('bar').style.width = (qi / quiz.length) * 100 + '%';
    const hint = $('qhint');
    if (multi) {
      hint.classList.remove('hide');
      hint.textContent = '可複選（選好後按下一題）';
    } else {
      hint.classList.add('hide');
    }
    const box = $('opts');
    box.innerHTML = '';
    item.opts.forEach((o, idx) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'opt' + (multi ? ' multi' : '');
      const sel = multi ? answers[qi].includes(idx) : answers[qi] === idx;
      if (sel) btn.classList.add('sel');
      btn.innerHTML = '<span class="tick"></span><span>' + o[0] + '</span>';
      btn.onclick = () => {
        if (multi) {
          const arr = answers[qi];
          const p = arr.indexOf(idx);
          if (p >= 0) arr.splice(p, 1);
          else arr.push(idx);
          renderQ();
        } else {
          answers[qi] = idx;
          renderQ();
          setTimeout(advance, 180);
        }
      };
      box.appendChild(btn);
    });
    const nb = $('next');
    nb.textContent = qi === quiz.length - 1 ? '看結果' : '下一題';
    nb.style.display = multi ? 'inline-flex' : 'none';
    nb.disabled = multi ? answers[qi].length === 0 : answers[qi] === null;
    $('prev').disabled = qi === 0;
  }

  function advance() {
    const item = quiz[qi];
    if (!item || (!item.multi && answers[qi] === null)) return;
    if (qi < quiz.length - 1) {
      qi++;
      renderQ();
    } else computeResult();
  }

  function nextQ() {
    const item = quiz[qi];
    if (!item) return;
    if (item.multi && answers[qi].length === 0) return;
    if (!item.multi && answers[qi] === null) return;
    if (qi < quiz.length - 1) {
      qi++;
      renderQ();
    } else computeResult();
  }

  function prevQ() {
    if (qi > 0) {
      qi--;
      renderQ();
    }
  }

  // CDP 數據收集（tracking-ready）：實際送出先 stub，待接 CDP。
  function trackCDP(payload) {
    // TODO: 串接 CDP，把 payload 送出（目前僅 stub，方便驗證有收到資料）
    if (typeof window !== 'undefined' && window.__CDP_DEBUG) console.log('[CDP]', payload);
  }

  function computeResult() {
    const score = { 自然系: 0, 質感系: 0, 溫暖系: 0, 神秘系: 0, 療癒系: 0, 探索系: 0 };
    const io = { 外: 0, 內: 0 };
    const cdp = { prefer_food: [], purchase_function: [], purchase_value: [] };
    quiz.forEach((item, i) => {
      const ans = answers[i];
      const picks = item.multi ? ans || [] : ans === null || ans === undefined ? [] : [ans];
      picks.forEach((idx) => {
        const o = item.opts[idx];
        if (!o) return;
        if (o[1]) score[o[1]]++;
        if (!item.multi && (o[2] === '外' || o[2] === '內')) io[o[2]]++;
        // o[3] = 選項上的 CDP 標記（題組1）：{prefer_food:[...]} | {purchase_function} | {purchase_value}
        const tags = o[3];
        if (tags) {
          for (const key in cdp) {
            if (tags[key] != null) cdp[key].push(...[].concat(tags[key]));
          }
        }
      });
    });
    const systems = Object.keys(score);
    systems.sort((a, b) => {
      const pa = score[a] / CEIL[a], pb = score[b] / CEIL[b];
      if (pb !== pa) return pb - pa;
      if (score[b] !== score[a]) return score[b] - score[a];
      return PRIORITY[a] - PRIORITY[b];
    });
    const mainSys = systems[0];
    const dir = io.外 > io.內 ? '外' : '內';
    resultSys = mainSys;
    resultDir = dir;
    trackCDP({ event: 'quiz_complete', version: ver, spirit: mainSys + '_' + dir, ...cdp });
    // Q6 後先問是否參加抽獎，再決定去抽獎流程或結果頁
    $('lotteryPrompt').classList.remove('hide');
  }

  function renderResult(sys, dir) {
    const key = sys + '_' + dir;
    const sp = SPIRITS[key];
    currentSpirit = sp;
    $('rio').textContent = sp.io;
    $('rname').textContent = sp.name;
    $('rquote').textContent = '「' + sp.quote + '」';
    $('rdesc').textContent = sp.desc;
    const m = MATCH[key];
    $('m1').textContent = SPIRITS[m.like].name;
    $('m2').textContent = SPIRITS[m.comp].name;
    const ca = CARE[sys];
    $('caret').textContent = ca.t;
    $('cared').textContent = ca.d;
    const cta = $('ctaTrend');
    cta.href = '/trends/' + SYS_TREND[sys];
    cta.textContent = '看「' + ca.t.split(' ')[0] + '」趨勢';
    $('bar').style.width = '100%';
    show('result');
  }

  // 看測驗結果（從彈窗／登入／表單任一處離開都走這）
  function goResult() {
    $('lotteryPrompt').classList.add('hide');
    renderResult(resultSys, resultDir);
  }

  // 參加抽獎：依 mock 狀態走 未登入→登入 / 已登入未填→表單 / 已登入已填→唯讀
  function goLottery() {
    $('lotteryPrompt').classList.add('hide');
    if (!mockLoggedIn) { show('login'); return; }
    buildLotteryForm();
    setFormReadonly(mockFilled);
    show('lottery');
  }

  let formBuilt = false;
  function buildLotteryForm() {
    if (formBuilt) return;
    formBuilt = true;
    // 縣市下拉
    const city = $('lotteryForm').city, area = $('lotteryForm').area;
    Object.keys(REGIONS).forEach((c) => {
      const o = document.createElement('option');
      o.value = c; o.textContent = c; city.appendChild(o);
    });
    // 縣市改變 → 連動鄉鎮市區
    city.addEventListener('change', () => {
      area.innerHTML = '<option value="" disabled selected>鄉鎮市區</option>';
      (REGIONS[city.value] || []).forEach((a) => {
        const o = document.createElement('option');
        o.value = a; o.textContent = a; area.appendChild(o);
      });
    });
    // 活動辦法內容
    const box = $('rulesBody');
    RULES.forEach((sec) => {
      const h = document.createElement('p');
      h.className = 'font-semibold text-ink-body';
      h.textContent = sec.h;
      box.appendChild(h);
      (sec.paras || []).forEach((p) => {
        const el = document.createElement('p');
        el.textContent = p;
        box.appendChild(el);
      });
      if (sec.list) {
        const ol = document.createElement('ol');
        ol.className = 'list-decimal space-y-1 pl-4';
        sec.list.forEach((li) => {
          const el = document.createElement('li');
          el.textContent = li;
          ol.appendChild(el);
        });
        box.appendChild(ol);
      }
    });
  }

  function setFormReadonly(ro) {
    const f = $('lotteryForm');
    ['name', 'email', 'phone', 'city', 'area', 'address', 'agree'].forEach((n) => { if (f[n]) f[n].disabled = ro; });
    $('filledNote').classList.toggle('hide', !ro);
    $('submitLottery').classList.toggle('hide', ro);
    $('agree').closest('label').classList.toggle('hide', ro);
    $('lotterySkip').textContent = ro ? '看測驗結果' : '先看測驗結果';
  }

  // 活動辦法收合
  $('rulesToggle').onclick = () => {
    const body = $('rulesBody');
    const open = body.classList.toggle('hide');
    $('rulesCaret').textContent = open ? '＋' : '－';
  };

  // 彈窗 / 登入 / 表單 的去向
  $('toLottery').onclick = goLottery;
  $('skipLottery').onclick = goResult;
  $('mockLogin').onclick = () => { mockLoggedIn = true; goLottery(); };
  $('loginSkip').onclick = goResult;
  $('lotterySkip').onclick = goResult;
  $('lotteryForm').onsubmit = (e) => {
    e.preventDefault();
    // 送出先 stub（之後接真實寫入＋ CDP）
    trackCDP({ event: 'lottery_submit', spirit: resultSys + '_' + resultDir });
    goResult();
  };

  // 區塊一社群分享：優先用原生分享，否則複製連結（hi-fi placeholder 行為）
  $('share').onclick = async () => {
    const url = location.href;
    const text = currentSpirit ? '我是「' + currentSpirit.name + '」！測測你的內在花精靈' : '測測你的內在花精靈';
    if (navigator.share) {
      try { await navigator.share({ title: '女人我最大賞 2026 花精靈測驗', text, url }); } catch (e) {}
    } else {
      try { await navigator.clipboard.writeText(url); alert('連結已複製，快分享給朋友！'); } catch (e) {}
    }
  };

  $('start').onclick = () => start('A');
  $('next').onclick = nextQ;
  $('prev').onclick = prevQ;
  $('replay').onclick = () => start(ver);
</script>

<style is:global>
  .hide { display: none !important; }
  /* 選項卡（JS 動態建立，需 global） */
  .opt {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    width: 100%;
    text-align: left;
    padding: 16px 18px;
    border: 0.5px solid #ebdcd6;
    border-radius: 8px;
    background: #fff;
    color: #3a2a2e;
    font-size: 16px;
    line-height: 1.55;
    cursor: pointer;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }
  .opt + .opt { margin-top: 12px; }
  .opt:hover { border-color: rgba(58, 42, 46, 0.3); }
  .opt.sel { border-color: #3a2a2e; background: #f8ece6; }
  .tick {
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
    margin-top: 2px;
    border-radius: 999px;
    border: 1.5px solid #c9bbb4;
    transition: all 0.2s ease;
  }
