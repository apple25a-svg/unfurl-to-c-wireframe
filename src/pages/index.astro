---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Intro from '../components/Intro.astro';
import TrendSection from '../components/TrendSection.astro';
import JurySection from '../components/JurySection.astro';
import QuizBand from '../components/QuizBand.astro';
import Footer from '../components/Footer.astro';
import { trends } from '../data/trends.js';
---

<BaseLayout title="女人我最大賞 2026 · UNFURL">
  <Header />
  <Hero />
  <Intro />

  <!-- 六大趨勢區塊標題：把鬆散的趨勢清單收進一個有大標的章節 -->
  <section class="px-6 pb-2 pt-16 text-center md:pt-20">
    <p class="font-serif text-sm tracking-[6px] text-ink-secondary md:text-base">U · N · F · U · R · L</p>
    <h2 class="mt-3 font-serif text-3xl tracking-[2px] text-heading md:text-[40px]">六大趨勢</h2>
  </section>

  {trends.map((t) => <TrendSection {...t} />)}

  <QuizBand />
  <JurySection />
  <Footer />
</BaseLayout>
