---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Intro from '../components/Intro.astro';
import TrendSection from '../components/TrendSection.astro';
import JurySection from '../components/JurySection.astro';
import QuizBand from '../components/QuizBand.astro';
import Footer from '../components/Footer.astro';
import { trends } from '../data/trends.js';
---

<BaseLayout title="女人我最大賞 2026 · UNFURL">
  <Header />
  <Hero />
  <Intro />

  {trends.map((t) => <TrendSection {...t} />)}

  <QuizBand />
  <JurySection />
  <Footer />
</BaseLayout>
