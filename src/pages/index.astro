---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Intro from '../components/Intro.astro';
import TrendSection from '../components/TrendSection.astro';
import JurySection from '../components/JurySection.astro';
import QuizBand from '../components/QuizBand.astro';
import Footer from '../components/Footer.astro';
import { trends } from '../data/trends.js';
---

<BaseLayout title="女人我最大賞 2026 · UNFURL">
  <Header />
  <Hero />
  <Intro />

  <!-- 六大趨勢章節開場：eyebrow → H2 → 框景引語，上下大留白，當「翻開章節」的扉頁 -->
  <section id="trends" class="scroll-mt-20 px-6 pb-12 pt-24 text-center md:pb-16 md:pt-32">
    <p class="text-xs tracking-[6px] text-ink-tertiary">U · N · F · U · R · L</p>
    <h2 class="mt-4 font-serif text-3xl text-heading md:text-[52px]">六大趨勢</h2>
    <p class="mx-auto mt-6 max-w-readable font-serif text-lg leading-relaxed text-ink-secondary md:text-xl">
      今年的美，正沿著六個方向綻放。
    </p>
  </section>

  {trends.map((t) => <TrendSection {...t} />)}

  <QuizBand />
  <JurySection />
  <Footer />
</BaseLayout>
