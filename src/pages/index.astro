---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import TrendCircle from '../components/TrendCircle.astro';
import TrendSection from '../components/TrendSection.astro';
import JurySection from '../components/JurySection.astro';
import QuizBand from '../components/QuizBand.astro';
import Footer from '../components/Footer.astro';
import { trends } from '../data/trends.js';
import { features } from '../config/features.js';
---

<BaseLayout title="女人我最大賞 2026 · UNFURL">
  <Header />
  <Hero />

  <!-- 章節開場：左文字、右圓圈 infographic（六大類繞 UNFURL） -->
  <section id="trends" class="scroll-mt-20 px-6 pb-12 pt-24 md:px-9 md:pb-16 md:pt-32">
    <div class="mx-auto grid max-w-frame items-center gap-12 md:grid-cols-2 md:gap-16">
      <div>
        <h2 class="font-serif text-3xl text-heading md:text-[52px]">UNFURL 2026 年度趨勢</h2>
        <p class="mt-4 max-w-[560px] font-serif text-lg leading-relaxed text-ink-secondary md:text-xl">
          美麗浪潮，正朝著六大風向綻放
        </p>
        <div class="mt-10 max-w-[560px] space-y-4 text-base leading-relaxed text-ink-body md:mt-12 md:text-lg">
          <p class="font-serif italic text-ink-secondary">濾鏡退場，綻放真實的美。</p>
          <p>從 McKinsey 的商業報告，到全球美妝集團紛紛翻新的商品論述，口服保養與醫美市場正迎來爆發性的成長；</p>
          <p>而在社群那端，小紅書瘋傳的「原圖直出」，到抖音的「原相機挑戰」；甚至在 Threads 上，越來越多人開始坦然面對自己的毛孔、紋理。</p>
          <p>種種訊號都在宣告：比起網感拉滿的精緻，當代女性更渴望真實的舒適與自在。</p>
          <p>《女人我最大》洞察這股集體覺醒的浪潮，濃縮為 2026 的年度關鍵字「<span class="font-serif italic">UNFURL</span>」。U-N-F-U-R-L 六個字母，代表六種正在發生的改變——從防禦修護、療癒儀式到醫美整合，從遮蓋到展現、從焦慮到自信、從追求完美到擁抱真實。2026 年，美不再是一張被修飾過的標準答案，是一種能自在伸展、自信綻放的生命狀態。</p>
        </div>
      </div>
      <TrendCircle />
    </div>
  </section>

  {trends.map((t) => (
    <TrendSection {...t} products={features.showProducts ? t.products : []} />
  ))}

  <JurySection />
  <QuizBand />
  <Footer />
</BaseLayout>
